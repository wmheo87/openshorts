# Copy to .env.local for local Vite development. Never put API keys in VITE_*.
VITE_DISCOVERY_ENABLED=0
VITE_PROXY_TARGET=http://localhost:8000
# Optional standalone P1 service; omit to use the regular backend.
# VITE_DISCOVERY_PROXY_TARGET=http://localhost:8002
# Leave VITE_API_URL unset for relative requests through the development proxy.
